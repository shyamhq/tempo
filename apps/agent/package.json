{
  "name": "@gmeher/tempo-agent",
  "version": "1.0.0",
  "description": "Tempo planning agent — local Claude Code driver that connects to a Tempo Thread.",
  "type": "module",
  "bin": {
    "tempo-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "tempo",
    "claude",
    "claude-code",
    "agent",
    "planning",
    "cli"
  ],
  "scripts": {
    "dev": "bun run build && node dist/cli.js",
    "build": "bun build --target=node --bundle src/cli.ts --outfile dist/cli.js --loader=.md:text",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@tempo/contracts": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "open": "^11.0.0",
    "proper-lockfile": "^4.1.2"
  }
}
