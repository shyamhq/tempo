{
  "name": "tempo-agent",
  "private": true,
  "type": "module",
  "bin": {
    "tempo-agent": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run build && node dist/cli.js",
    "build": "bun build --target=node --bundle --external node-pty src/cli.ts --outfile dist/cli.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"const p=require('path').dirname(require.resolve('node-pty/package.json'))+'/prebuilds';const fs=require('fs');if(fs.existsSync(p)){for(const d of fs.readdirSync(p)){const h=require('path').join(p,d,'spawn-helper');if(fs.existsSync(h))fs.chmodSync(h,0o755);}}\""
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "pino-pretty": "^13.1.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tempo/contracts": "workspace:*",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
