# Console environment variables
# Copy to .env.local for local development.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo

# Clerk auth (get from Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Console public URL (used for RSC fetch self-calls)
# Leave unset in local dev — Next.js derives it from request headers.
# NEXT_PUBLIC_CONSOLE_URL=https://console.tempo.dev

# Worker URL — browser calls go here with Bearer Clerk JWT.
# In dev: http://localhost:3001 (Worker's default port).
# In prod: https://worker.tempo.dev
NEXT_PUBLIC_WORKER_URL=http://localhost:3001

# CLI auth shared secret — must match Worker's CLI_AUTH_SECRET (min 32 bytes).
CLI_AUTH_SECRET=

# Email (Resend)
RESEND_API_KEY=re_...

# GitHub App (tier1 connector — Settings → Integrations → GitHub)
# Create a GitHub App at https://github.com/settings/apps and set:
#   Callback URL:    <CONSOLE_URL>/api/connectors/github/callback
#   (routed via the dynamic [id] segment; no separate github/ directory needed)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Pipedream Connect (tier2 connectors — Linear, Jira, Sentry, Notion, Slack, Vercel, Figma)
# Create a Pipedream project at https://pipedream.com/projects and enable Connect.
# Register the callback URL in the project settings:
#   success_redirect_uri: <CONSOLE_URL>/api/connectors/{connector_id}/callback
# The [id] segment handles each app's callback; id matches the ConnectorId enum.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=production
