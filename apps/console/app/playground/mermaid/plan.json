                "textAlignment": "left"
              },
              "content": [
                { "type": "text", "text": "Create " },
                {
                  "type": "text",
                  "marks": [{ "type": "code" }],
                  "text": "apps/api/src/adapters/redis.ts"
                },
                { "type": "text", "text": " — thin cache adapter: " },
                { "type": "text", "marks": [{ "type": "code" }], "text": "cache.get(key)" },
                { "type": "text", "text": " and " },
                {
                  "type": "text",
                  "marks": [{ "type": "code" }],
                  "text": "cache.set(key, value, ttlSeconds)"
                },
                { "type": "text", "text": ". When " },
                { "type": "text", "marks": [{ "type": "code" }], "text": "REDIS_URL" },
                {
                  "type": "text",
                  "text": " is absent, both are no-ops. Handles JSON serialization and swallows Redis errors (logs + returns null, so an outage degrades gracefully instead of 500ing)."
                }
              ]
            }
          ]
        },
        {
          "type": "blockContainer",
