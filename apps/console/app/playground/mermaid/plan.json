                },
                { "type": "text", "text": " — wrap " },
                { "type": "text", "marks": [{ "type": "code" }], "text": "getAlbumOrThrow" },
                { "type": "text", "text": " and " },
                { "type": "text", "marks": [{ "type": "code" }], "text": "assertMember" },
