# Worker environment variables
# Copy to .env.local for local development.

# Database (same Postgres instance as Console)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo

PORT=3001
NODE_ENV=development
WORKER_LOG_LEVEL=info

# Clerk auth (same secret key as Console — single Clerk app)
CLERK_SECRET_KEY=sk_test_...

# CLI auth shared secret — must match Console's CLI_AUTH_SECRET (min 32 bytes).
CLI_AUTH_SECRET=
TOKEN_HASH_PEPPER=

# CORS — allow Console origin to call Worker endpoints with Authorization headers.
# In dev: http://localhost:3000
# In prod: https://console.tempo.dev
CONSOLE_ORIGIN=http://localhost:3000

# R2 / MinIO attachment storage
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=tempo-local
R2_SECRET_ACCESS_KEY=tempo-local-secret
R2_REGION=auto
R2_BUCKET=tempo-attachments
