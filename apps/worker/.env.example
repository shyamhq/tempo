# Worker environment variables
# Copy to .env.local for local development.

# Database (same Postgres instance as Console)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo

# Redis — real-time event delivery (streams) + shared cache. Required.
REDIS_URL=redis://localhost:6379

PORT=3001
NODE_ENV=development
WORKER_LOG_LEVEL=info

# Clerk auth (same secret key as Console — single Clerk app)
CLERK_SECRET_KEY=sk_test_...

# CLI auth shared secret — must match Console's CLI_AUTH_SECRET (min 32 bytes).
CLI_AUTH_SECRET=
TOKEN_HASH_PEPPER=
# Hosted Session JWT signing secret — Worker-only; never reaches the Sandbox
# (Worker signs, the Sandbox carries the resulting sk_hosted_* token). Min 32 bytes.
HOSTED_AUTH_SECRET=

# CORS — allow Console origin to call Worker endpoints with Authorization headers.
# In dev: http://localhost:3000
# In prod: https://console.tempo.dev
CONSOLE_ORIGIN=http://localhost:3000

# E2B Sandbox provisioning — Worker-only; never reaches the Sandbox.
# Two credentials, two purposes:
#   E2B_API_KEY     → runtime, used by Sandbox.create() in provision.ts.
#                     Dashboard → Team tab → API Keys.
#   E2B_ACCESS_TOKEN → build-time, used by Template.build() when
#                     publishing the hosted-runner template.
#                     Dashboard → Personal tab → Access Tokens.
E2B_API_KEY=
E2B_ACCESS_TOKEN=
# Moonshot (Kimi) — the hosted agent's model, via Moonshot's OpenAI-compatible
# endpoint. Worker holds the key; provision injects it into the Sandbox
# per-Session for the runner's model calls. Egress permits api.moonshot.ai.
MOONSHOT_API_KEY=
# Optional override — defaults to https://api.moonshot.ai/v1 (use .cn for China).
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Tavily — provider-agnostic web search + page fetch for the hosted agent.
# Egress permits api.tavily.com. Free tier at tavily.com.
TAVILY_API_KEY=
# URL the Sandbox uses to reach Worker (for MCP calls). In dev, must be
# reachable from inside E2B — usually an ngrok tunnel since E2B can't reach
# loopback. In prod: https://worker.tempo.dev (or wherever Worker is hosted).
WORKER_PUBLIC_URL=http://localhost:3001

# Connectors (slice 3) — all optional; connectors are additive. The connector
# clients read these from process.env and assert presence at call time, so an
# unset value only matters once a workspace connects that service.
#   Pipedream — OAuth vault + dispatch for every tier-2 connector (Linear, etc).
#   Dashboard → Settings → API. Same vars belong in the Console env too.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development
#   GitHub App — the one tier-1 connector. PRIVATE_KEY is the PEM contents
#   (\n-escaped newlines are fine). SLUG is the App's URL slug (install link).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# R2 / MinIO attachment storage
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=tempo-local
R2_SECRET_ACCESS_KEY=tempo-local-secret
R2_REGION=auto
R2_BUCKET=tempo-attachments
