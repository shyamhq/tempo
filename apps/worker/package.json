{
  "name": "@tempo/worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build": "bun build --target=node --bundle src/index.ts --outfile dist/index.js",
    "start": "node dist/index.js",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tempo/contracts": "workspace:*",
    "@tempo/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "pino-pretty": "^13.1.3"
  }
}
