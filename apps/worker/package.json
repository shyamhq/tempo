{
  "name": "@tempo/worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun --watch --loader=.md:text run src/index.ts",
    "build": "bun build --target=node --bundle src/index.ts --outfile dist/index.js --loader=.md:text",
    "build:hosted-runner": "bun run scripts/build-hosted-runner.ts",
    "start": "node dist/index.js",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.178",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@blocknote/core": "^0.51.4",
    "@blocknote/server-util": "^0.51.4",
    "@clerk/backend": "^3.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tempo/contracts": "workspace:*",
    "@tempo/db": "workspace:*",
    "@tempo/server": "workspace:*",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "e2b": "^2.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "nanoid": "^5.1.11",
    "pino": "^10.3.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "pino-pretty": "^13.1.3"
  }
}
