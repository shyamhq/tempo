# Console
# Postgres. Local dev: `docker compose up -d` (see docker-compose.yml).
# Prod: Railway injects DATABASE_URL automatically from the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo
CONSOLE_URL=http://localhost:3000
LOG_LEVEL=info

# Attachment store (S3-compatible). Defaults match docker-compose MinIO; in
# prod, point at Cloudflare R2 (https://<account>.r2.cloudflarestorage.com).
# Set a bucket lifecycle rule on R2 in prod: delete objects whose key has no
# referencing DB row (or simply: TTL all objects 7 days after upload — Send
# moves the object to a permanent prefix, orphans get swept).
R2_ENDPOINT=http://127.0.0.1:9000
R2_REGION=auto
R2_BUCKET=tempo-attachments
R2_ACCESS_KEY_ID=tempo-local
R2_SECRET_ACCESS_KEY=tempo-local-secret

# Clerk — auth. Required at boot.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Filled by Clerk Dashboard → Webhooks once the endpoint is registered
# (POST /api/webhooks/clerk). Optional until configured; without it the
# webhook route returns 500.
CLERK_WEBHOOK_SECRET=

# Resend — workspace invite email. Optional in local dev; the invite still
# creates a Clerk invitation, just without the branded email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=invites@tempo.app

# CLI auth — shared between Console and Worker. Must be the same value in both.
# Generate with: openssl rand -hex 32
CLI_AUTH_SECRET=replace_with_32_bytes_of_entropy_hex

# Worker
# Pepper added to all token hashes (SHA-256) to protect against DB dump attacks.
# Generate with: openssl rand -hex 32
# Rotating this value invalidates all active CLI tokens.
TOKEN_HASH_PEPPER=replace_with_32_bytes_of_entropy_hex

# Clerk secret key for Worker (same as CLERK_SECRET_KEY above; duplicated so
# Worker can run without access to Console's env file).
# CLERK_SECRET_KEY is already set above — Worker reads the same var name.

# Agent CLI
# (uses CONSOLE_URL above to know where to talk; no separate env)
