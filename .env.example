# Console
# Postgres. Local dev: `docker compose up -d` (see docker-compose.yml).
# Prod: Railway injects DATABASE_URL automatically from the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo
CONSOLE_URL=http://localhost:3000
LOG_LEVEL=info

# Attachment store (S3-compatible). Defaults match docker-compose MinIO; in
# prod, point at Cloudflare R2 (https://<account>.r2.cloudflarestorage.com).
# Set a bucket lifecycle rule on R2 in prod: delete objects whose key has no
# referencing DB row (or simply: TTL all objects 7 days after upload — Send
# moves the object to a permanent prefix, orphans get swept).
R2_ENDPOINT=http://127.0.0.1:9000
R2_REGION=auto
R2_BUCKET=tempo-attachments
R2_ACCESS_KEY_ID=tempo-local
R2_SECRET_ACCESS_KEY=tempo-local-secret

# Agent CLI
# (uses CONSOLE_URL above to know where to talk; no separate env)
