# Dependencies
node_modules
**/node_modules

# Next.js build output (rebuilt inside Docker)
**/.next
apps/console/.next

# Local dev data
apps/console/data
*.db
*.db-journal

# Git
.git
.gitignore

# Env files — exclude at every level. A bare `.env.*` only matches the context
# root, so nested apps/console/.env.local was leaking local dev creds into the
# image (Next logged "Environments: .env.local" during the build).
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Misc
.DS_Store
*.log
